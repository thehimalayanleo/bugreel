{
  "name": "bugreel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "bugreel": "./bin/bugreel.mjs"
  },
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"node --env-file-if-exists=.env server/index.js\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test server/*.test.js src/*.test.js",
    "bugreel": "node bin/bugreel.mjs",
    "demo:cli": "node bin/bugreel.mjs --sample"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "vite": "8.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {}
}
